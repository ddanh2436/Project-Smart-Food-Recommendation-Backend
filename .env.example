# ============================================================
#  VietNomNom — Backend (NestJS)  |  .env.example
#  Copy to `.env` and fill in real values. NEVER commit `.env`.
# ============================================================

# --- Server ---
# Render injects PORT automatically. Locally 3001 matches the Frontend default.
PORT=3001
NODE_ENV=development

# --- Database (MongoDB Atlas) ---
# Atlas > Database > Connect > Drivers. Add the DB name before the `?`.
# Remember to allow 0.0.0.0/0 in Atlas > Network Access for Render.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/VietNomNom?retryWrites=true&w=majority

# --- JWT ---
# Generate new ones with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-me
JWT_REFRESH_SECRET=replace-me-with-a-different-value
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Google OAuth ---
# console.cloud.google.com > APIs & Services > Credentials > OAuth 2.0 Client ID
# Authorized redirect URI must be exactly: <BACKEND_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Service URLs ---
# BACKEND_URL is used to build the Google OAuth callback URL. No trailing slash.
BACKEND_URL=http://localhost:3001
# FRONTEND_URL is where Google login redirects back to. No trailing slash.
FRONTEND_URL=http://localhost:3000
# The FastAPI AI service (Hugging Face Space in production). No trailing slash.
AI_SERVICE_URL=http://127.0.0.1:5000

# --- CORS ---
# Comma-separated list of allowed browser origins. No trailing slashes.
CORS_ORIGINS=http://localhost:3000
# Optional: allow this project's Vercel preview deployments
# (https://<project>-<hash>-<team>.vercel.app). Both must be set; leave empty
# to allow only the origins listed above.
VERCEL_PREVIEW_PROJECT=
VERCEL_TEAM_SLUG=

# --- Admin ---
# Long random string required by admin-only endpoints (e.g. sentiment backfill),
# sent as the `x-admin-token` header.
ADMIN_TOKEN=replace-me

# Shared secret between the backend and the AI service. The backend sends it
# as x-internal-token; the AI service refuses data requests without it once
# set. Use the same long random value on both. Set it on the backend first.
INTERNAL_API_TOKEN=

# Proxy hops in front of the app (Render: 1). Verify with GET /admin/client-ip.
TRUST_PROXY_HOPS=1
